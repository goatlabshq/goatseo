{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "goatseo",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "packages/goatseo/pyproject.toml",
        "packages/goatseo-core/pyproject.toml",
        "packages/goatseo-schema/pyproject.toml",
        "packages/goatseo-opengraph/pyproject.toml",
        "packages/goatseo-twitter/pyproject.toml",
        "packages/goatseo-seo/pyproject.toml",
        "packages/goatseo-django/pyproject.toml",
        "packages/goatseo-fastapi/pyproject.toml",
        "packages/goatseo-flask/pyproject.toml",
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='goatseo')].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='goatseo-core')].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='goatseo-django')].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='goatseo-fastapi')].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='goatseo-flask')].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='goatseo-opengraph')].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='goatseo-schema')].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='goatseo-seo')].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='goatseo-twitter')].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='goatseo-workspace')].version"
        }
      ],
      "release-as": "0.1.2"
    }
  }
}
